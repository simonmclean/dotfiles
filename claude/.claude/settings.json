{
  "outputStyle": "Concise",
  "permissions": {
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/src/confirm-commit-push-pr.ts",
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash|Read|Write|Edit|MultiEdit|NotebookEdit|Glob|Grep|LSP",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/src/confirm-outside-project.ts"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/src/session-git-state.ts",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
